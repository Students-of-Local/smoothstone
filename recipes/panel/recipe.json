    "cut_shape": "round",
    "cut_w": 30,
    "cut_pitch": 38,
    "cut_y": 5,
    "holes": "corners",
    "countersink": true,
    "label": "TEMP  VOLTS  AMPS",
    "label_size": 4.5
   }
  },
  {
   "name": "blank_engraved",
   "params": {
    "w": 70,
    "d": 115,
    "cutouts": 0,
    "holes": "top_bottom",
    "label": "OFFICE",
    "label_size": 10,
    "label_y": 0,
    "label_style": "engraved",
    "corner_r": 6,
    "hole_inset": 15.85
   }
  },
  {
   "name": "switch",
   "params": {
    "w": 70,
    "d": 115,
    "cutouts": 1,
    "cut_shape": "rounded",
    "cut_w": 34,
    "cut_h": 67,
    "holes": "top_bottom",
    "countersink": true,
    "thickness": 4,
    "hole_inset": 15.85
   }
  }
 ],
